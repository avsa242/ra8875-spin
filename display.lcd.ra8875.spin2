pub preset_adafruit_800x480()
' Preset:
'   800x480 (5.0" or 7.0" panel w/resistive touchscreen, Adafruit PNs 1596, 1680, 2353, 2354)
'   1kHz backlight PWM freq
    _disp_width := 800
    _disp_height := 480
    _pixclk := core.PCLK_FALLING | core.PCLK_PERIOD_2CLK
    _hsync_nondisp := 26
    _hsync_start := 32
    _hsync_pw := 96
    _hsync_finetune := 0
    _vsync_nondisp := 32
    _vsync_start := 23
    _vsync_pw := 2
    _voffset := 0

    _bl_pwm_freq := 1000

    set_timings()

    ' clear window
    writereg(core.MCLR, core.MCLR_START | core.MCLR_FULL)
    waitms(500)

    powered(true)
    gpiox_state(1)
    pwm1_config(true, core.PWM1_SYSCLK1024)
    pwm1_duty(255)


pub box(x1, y1, x2, y2, c, f=false)
' Draw a box
'   (x1, y1):   start coordinates
'   (x2, y2):   end coordinates
'   c:          color
'   f:          fill box (default: no)

    ' set coordinates
    set_xy(x1, y1, x2, y2)

    ' set color 
    fgcolor(c)

    ' draw
    writecmd(core.DCR)
    if ( f )
        writedata(core.DRAW_LINE_SQU_TRI | core.FILL_CIR_SQU_TRI | core.DRAW_SQUARE)
    else
        writedata(core.DRAW_LINE_SQU_TRI | core.DRAW_SQUARE)

    ' Wait for the command to finish 
    waitnot(core.DCR, core.LINE_SQU_TRI_BUSY)


pub box_rounded(x1, y1, x2, y2, hr, vr, c, f) | w, h
' Draw a box with rounded corners
'   (x1, y1):   start coordinates
'   (x2, y2):   end coordinates
'   hr:         corner horizontal radius
'   vr:         corner vertical radius
'   c:          color
'   f:          fill box
    if ( x2 < x1 )
        x1, x2 := x2, x1
    if ( y2 < y1 )
        y1, y2 := y2, y1

    w := x2-x1
    h := y2-y1

    hr := hr <# w/2                             ' limit radius to half width/height to avoid
    vr := vr <# h/2                             '   erratic drawing

    ' set coordinates
    set_xy(x1, y1, x2, y2)

    ' set corners radius
    writecmd(core.ELL_A0)
    writedata(hr.byte[0])
    writecmd(core.ELL_A1)
    writedata( (hr.byte[1] & %11) )

    writecmd(core.ELL_B0)
    writedata(vr.byte[0])
    writecmd(core.ELL_B1)
    writedata( (vr.byte[1] & %1) )

    ' set color
    fgcolor(c)

    ' draw
    writecmd(core.DCSCR)
    if ( f )
        writedata(core.DRAW_ELL_CIRSQU | core.FILL_ELL_CIRSQU | core.DRAW_CIRSQU)
    else
        writedata(core.DRAW_ELL_CIRSQU | core.DRAW_CIRSQU)

    ' wait for the command to finish 
    waitnot(core.DCSCR, core.ELL_CIRSQU_BUSY)


pub brightness(b)
' Set LCD backlight brightness
'   b:  percentage (0..100)

    b := (0 #> b <# 100) * 10                   ' clamp range 0..100, scale to usec

    if ( lookdown(_LITE: 0..63) )               ' make sure I/O pin is valid first
        pinstart(   _LITE, ...
                    (P_PWM_SAWTOOTH | P_OE), ...            ' PWM smart-pin mode, enable output
                    ( (1_000_000/_bl_pwm_freq) << 16) | ... ' pulse period
                    (clkfreq/1_000_000), ...                ' timing granularity (1uS)
                    b )


pub char_attrs(a) | tmp
' Set text rendering character attributes
'   DRAWBG (1):     draw background color
    tmp := readreg(core.FNCR1)
    tmp &= core.FONT_TRANSP_MASK

    if ( a & DRAWBG )
        tmp |= 1 << core.FONT_TRANSP

    writereg(core.FNCR1, tmp)


pub circle(x, y, r, c, f=false)
' Draw a circle
'   (x, y):     center coordinates
'   r:          radius
'   c:          color
'   f:          fill the circle (optional; default is no/false)

    ' set coordinates
    writecmd(core.DCHR0)
    writedata(x.byte[0])
    writecmd(core.DCHR1)
    writedata(x.byte[1] & core.DCHR1_MASK)

    writecmd(core.DCVR0)
    writedata(y.byte[0])
    writecmd(core.DCVR1)
    writedata(y.byte[1] & core.DCVR1_MASK)

    ' set radius
    writecmd(core.DCRR)
    writedata(r & $ff)

    ' set color
    fgcolor(c)

    ' fill flag: convert any non-zero value to 1
    f := (f <> 0) ? 1 : 0

    writecmd(core.DCR)
    writedata(core.DRAW_CIRCLE | (f << core.FCSTS) )

    ' Wait for the command to finish 
    waitnot(core.DCR, core.LINE_SQU_TRI_BUSY)


pub dev_id(): i
' Get the device ID from the display controller
    return readreg(core.DEV_ID)


pub draw_area(sx, sy, ex, ey)
' Set drawable area of the display
'   (sx, sy):   upper-left corner of active window
'   (ex, ey):   lower-right corner of active window

    ' sx, sy
    writecmd(core.HSAW0)
    writedata(sx.byte[0])
    writecmd(core.HSAW1)
    writedata(sx.byte[1] & %11)
    writecmd(core.VSAW0)
    writedata(sy.byte[0])
    writecmd(core.VSAW1)
    writedata(sy.byte[1] & %1)

    ' ex, ey
    writecmd(core.HEAW0)
    writedata(ex.byte[0])
    writecmd(core.HEAW1)
    writedata(ex.byte[1] & %11)
    writecmd(core.VEAW0)
    writedata(ey.byte[0])
    writecmd(core.VEAW1)
    writedata(ey.byte[1] & %1)


pub fgcolor(c)
' Set foreground color of subsequent drawing operations
    writecmd(core.FGCR0)
    writedata( (c & REDMASK) >> 11)
    writecmd(core.FGCR1)
    writedata( (c & GREENMASK) >> 5)
    writecmd(core.FGCR2)
    writedata(c & BLUEMASK)


pub font_encoding(e): c
' Set font encoding for text
'   e:
'       FONT_ENC_ISO8859_1 (0): ISO 8859-1 (Latin-1/Western-European languages)
'       FONT_ENC_ISO8859_2 (1): ISO 8859-2 (Latin-2/Eastern-European languages)
'       FONT_ENC_ISO8859_3 (2): ISO 8859-3 (Latin-3/South-European languages)
'       FONT_ENC_ISO8859_4 (3): ISO 8859-4 (Latin-4/North-European languages)
'       other values:           return the current setting
    c := readreg(core.FNCR0)
    case e
        FONT_ENC_ISO8859_1..FONT_ENC_ISO8859_4:
            e := (c & core.CGROM_FONT_ENC_MASK) | e
            writereg(core.FNCR0, e)
        other:
            return (e & core.CGROM_FONT_ENC_BITS)


pub font_scl(x, y) | tmp
' Set font rendering scale factor
'   x, y: 1..4 (clamped to range)
    x := (x #> 1 <# 4)-1                        ' scale to reg values
    y := (y #> 1 <# 4)-1

    tmp := readreg(core.FNCR1) & core.FONT_SCALE_MASK
    tmp |= (x << core.FONT_HSCALE) | y
    writereg(core.FNCR1, tmp)


pub gpiox_state(s)
' Set extra GPIO state
    writereg(core.GPIOX, (s <> 0) & 1)


pub int_clear(m)
' Clear interrupt(s)
'   m:
'       INT_FONTWRITE (1):      font character write to DDRAM complete
'                               (valid when BTE disabled, text mode enabled)
'       INT_BTE (1):            BTE interrupt for MCU R/W
'                               (valid when BTE enabled and BTE operation initiated)

'       INT_BTE_COMPLETE (2):   BTE process complete
'       INT_TOUCHED (4):        touchscreen touched
'       INT_DMA (8):            DMA interrupt
'       INT_KEYSCAN (16):       keyscan interrupt
    writereg(core.INTC2, m & core.INTC2_REGMASK)


pub int_mask(m)
' Set interrupt mask
'   m:
'       INT_FONTWRITE (1):      font character write to DDRAM complete
'                               (valid when BTE disabled, text mode enabled)
'       INT_BTE (1):            BTE interrupt for MCU R/W
'                               (valid when BTE enabled and BTE operation initiated)
'       INT_BTE_COMPLETE (2):   BTE process complete
'       INT_TOUCHED (4):        touchscreen touched
'       INT_DMA (8):            DMA interrupt
'       INT_KEYSCAN (16):       keyscan interrupt
    writereg(core.INTC1, m & core.INTC1_REGMASK)


pub interrupt(): i
' Get interrupt source(s)
'   Returns:
'       INT_FONTWRITE (1):      font character write to DDRAM complete
'                               (valid when BTE disabled, text mode enabled)
'       INT_BTE (1):            BTE interrupt for MCU R/W
'                               (valid when BTE enabled and BTE operation initiated)
'       INT_BTE_COMPLETE (2):   BTE process complete
'       INT_TOUCHED (4):        touchscreen touched
'       INT_DMA (8):            DMA interrupt
'       INT_KEYSCAN (16):       keyscan interrupt
    return readreg(core.INTC2) & core.INTC2_REGMASK


pub line(x1, y1, x2, y2, c)
' Draw a line
'   (x1, y1):   starting coordinates
'   (x2, y2):   ending coordinates
'   c:          color

    set_xy(x1, y1, x2, y2)

    fgcolor(c)

    ' draw line
    writecmd(core.DCR)
    writedata(core.DRAW_LINE_SQU_TRI)

    ' Wait for the command to finish 
    waitnot(core.DCR, core.LINE_SQU_TRI_BUSY)


pub mirror_h(m=-2): c
' Mirror the display horizontally
'   m:
'       true (-1 or 1): mirror the display
'       false (0):      no mirroring
'       other values:   return the current setting
    c := readreg(core.DPCR)
    case abs(m)
        0, 1:
            c := (c & core.HDIR_MASK) | ( (m & 1) << core.HDIR)
            writereg(core.DPCR, c)
        other:
            return ( (c >> core.HDIR) & 1 ) == 1


pub mirror_v(m=-2): c
' Mirror the display vertically
'   m:
'       true (-1 or 1): mirror the display
'       false (0):      no mirroring
'       other values:   return the current setting
    c := readreg(core.DPCR)
    case abs(m)
        0, 1:
            c := (c & core.VDIR_MASK) | ( (m & 1) << core.VDIR)
            writereg(core.DPCR, c)
        other:
            return ( (c >> core.VDIR) & 1 ) == 1


pub opmode(m): c
' Set display operating mode
'   m:
'       OPMODE_GFX (0):     graphics
'       OPMODE_TEXT ($80):  text
'       other values:       return the current setting

    c := readreg(core.MWCR0)
    case m
        OPMODE_GFX, OPMODE_TEXT:
            m := (c & core.TME_MASK) | m
            writereg(core.MWCR0, m)
        other:
            return (c & core.TME_BIT)


pub pll_init()
' Initialize PLL
{    if ( _size == RA8875_480x80 or _size == RA8875_480x128 or _size == RA8875_480x272 )
        writereg(RA8875_PLLC1, RA8875_PLLC1_PLLDIV1 + 10)
        waitms(1)
        writereg(RA8875_PLLC2, RA8875_PLLC2_DIV4)
        waitms(1)
    else    '(_size == RA8875_800x480)}
        writereg(core.PLLC1, core.PLLDIVM_DIV1 + 11)
        waitms(1)
        writereg(core.PLLC2, core.PLLDIVK_DIV4)
        waitms(1)


pub pos_xy(x, y)
' Set text cursor
'   (x, y) coordinates (pixel-level)
    writecmd(core.F_CURXL)
    writedata(x & $ff)
    writecmd(core.F_CURXH)
    writedata(x >> 8)
    writecmd(core.F_CURYL)
    writedata(y & $ff)
    writecmd(core.F_CURYH)
    writedata(y >> 8)


pub powered(p)
' Enable display power
'   p:  true (non-zero values): power on
'       false (0): power off

    if ( p )
        writereg(core.PWRR, core.DISP_NORMAL | core.DISP_ON)
    else
        writereg(core.PWRR, core.DISP_NORMAL | core.DISP_OFF)


pub putchar(c)
' Draw a single character on the display
'   NOTE: control codes glyph will be drawn, the codes will not be processed/interpreted
    writecmd(core.MRWC)
    writedata(c)


pub puts_fast(p_str) | l, p  'xxx api tentative
' Draw a string on the display
    l := strsize(p_str)
    if ( l )
        writecmd(core.MRWC)
        p := p_str
        repeat l
            writedata(byte[p++])

    return


pub pwm1_config(e, clk)
' Configure PWM1 output
    if ( e )
        writereg(core.P1CR, core.P1CR_ENABLE | (clk & $f) )
    else
        writereg(core.P1CR, core.P1CR_DISABLE | (clk & $f) )


pub pwm1_duty(p)
' Set PWM1 pin duty cycle
    writereg(core.P1DCR, p)


pub reset()
' Reset th display controller
    if ( lookdown(_RST: 0..63) )                ' only touch the pin if it was defined at
        pinl(_RST)                              '   driver startup
        waitms(100)
        pinh(_RST)
        waitms(100)
    else
        writereg(core.PWRR, core.SOFT_RESET)
        waitms(100)
        writereg(core.PWRR, core.SOFT_RESET_CLR)
        waitms(100)


pub scroll_left(px)
' Scroll a region of the display left
'   px:     number of pixels to scroll
'   NOTE: The area of the screen to scroll must first be defined with set_scroll_area()
    writecmd(core.HOFS0)
    writedata(px.byte[0])
    writecmd(core.HOFS1)
    writedata(px.byte[1] & %11)


pub scroll_up(px)
' Scroll a region of the display left
'   px:     number of pixels to scroll
'   NOTE: The area of the screen to scroll must first be defined with set_scroll_area()
    writecmd(core.VOFS0)
    writedata(px.byte[0])
    writecmd(core.VOFS1)
    writedata(px.byte[1] & %1)


pub set_font(f) | tmp
' Set font
'   FONT_ROM (0):   built-in ROM font
'   FONT_RAM ($80): RAM font (not yet implemented)
    tmp := readreg(core.FNCR0)
    case f
        FONT_ROM, FONT_RAM:
            f := (tmp & core.CGROM_FONT_MASK) | f   ' clear CGRAM_ROM_FONT and CGROM_INT_EXT
            writecmd(core.FNCR0)
            writedata(f)
            ifnot ( f & core.CGROM_INT_EXT_BIT )
                writecmd(core.F_SFRS)
                writedata($00)


pub set_scroll_area(sx, sy, ex, ey)
' Set scroll area of the display
'   (sx, sy):   upper-left corner of scroll area
'   (ex, ey):   lower-right corner of scroll area

    ' sx, sy
    writecmd(core.HSSW0)
    writedata(sx.byte[0])
    writecmd(core.HSSW1)
    writedata(sx.byte[1] & %11)
    writecmd(core.VSSW0)
    writedata(sy.byte[0])
    writecmd(core.VSSW1)
    writedata(sy.byte[1] & %1)

    ' ex, ey
    writecmd(core.HESW0)
    writedata(ex.byte[0])
    writecmd(core.HESW1)
    writedata(ex.byte[1] & %11)
    writecmd(core.VESW0)
    writedata(ey.byte[0])
    writecmd(core.VESW1)
    writedata(ey.byte[1] & %1)


pub set_timings()   'xxx api tentative
' Set up/configure LCD panel display timings
    writereg(core.PCSR, _pixclk)
    waitms(1)

    ' horizontal settings
    writereg(core.HDWR, (_disp_width / 8) - 1)                      ' H width: (HDWR + 1) * 8
    writereg(core.HNDFTR, core.DE_HIGH + _hsync_finetune)
    writereg(core.HNDR, (_hsync_nondisp - _hsync_finetune - 2) / 8) ' H non-display: HNDR * 8 + HNDFTR + 2
    writereg(core.HSTR, _hsync_start / 8 - 1)                       ' Hsync start: (HSTR + 1)*8
    writereg(core.HPWR, core.HSYNC_POL_LOW + (_hsync_pw / 8 - 1))   ' HSync pulse width = (HPWR+1) * 8

    ' vertical settings
    writereg(core.VDHR0, (_disp_height - 1 + _voffset) & $ff)
    writereg(core.VDHR1, (_disp_height - 1 + _voffset) >> 8)
    writereg(core.VNDR0, _vsync_nondisp - 1)                        ' V non-display period = VNDR + 1
    writereg(core.VNDR1, _vsync_nondisp >> 8)
    writereg(core.VSTR0, _vsync_start - 1)                          ' Vsync start position = VSTR + 1
    writereg(core.VSTR1, _vsync_start >> 8)
    writereg(core.VPWR, core.VSYNC_POL_LOW + _vsync_pw - 1)         ' Vsync pulse width = VPWR + 1

    ' set active window x
    writereg(core.HSAW0, 0)                                         ' horizontal start point
    writereg(core.HSAW1, 0)
    writereg(core.HEAW0, (_disp_width - 1) & $ff)                   ' horizontal end point
    writereg(core.HEAW1, (_disp_width - 1) >> 8)

    ' set active window y
    writereg(core.VSAW0, 0 + _voffset)                              ' vertical start point
    writereg(core.VSAW1, 0 + _voffset)
    writereg(core.VEAW0, (_disp_height - 1 + _voffset) & $ff)       ' vertical end point
    writereg(core.VEAW1, (_disp_height - 1 + _voffset) >> 8)


pub set_xy(x1, y1, x2=-1, y2=-1)
' Set cursor/drawing position
'   (x1, y1):   point 1/starting coordinates
'   (x2, y2):   point 2/ending coordinates (optional; ignored if unspecified or if set less than 0)
    ' write start coordinates
    writecmd(core.DLHSR0)
    writedata(x1.byte[0])
    writecmd(core.DLHSR1)
    writedata(x1.byte[1] & core.DLHSR1_MASK)

    writecmd(core.DLVSR0)
    writedata(y1.byte[0])
    writecmd(core.DLVSR1)
    writedata(y1.byte[1] & core.DLVSR1_MASK)

    ' write ending coordinates if specified (and valid)
    if ( (x2 >= 0) and (y2 >= 0) )
        writecmd(core.DLHER0)
        writedata(x2.byte[0])
        writecmd(core.DLHER1)
        writedata(x2.byte[1] & core.DLHER1_MASK)

        writecmd(core.DLVER0)
        writedata(y2.byte[0])
        writecmd(core.DLVER1)
        writedata(y2.byte[1] & core.DLVER1_MASK)


pub triangle(x1, y1, x2, y2, x3, y3, c, f=false)
' Draw a triangle
'   (x1, y1):   point 1 coordinates
'   (x2, y2):   point 2 coordinates
'   (x3, y3):   point 3 coordinates
'   c:          color
'   f:          fill box (default: no)

    ' set coordinates
    ' points 1, 2
    set_xy(x1, y1, x2, y2)

    ' point 3
    writecmd(core.DTPH0)
    writedata(x3.byte[0])
    writecmd(core.DTPH1)
    writedata(x3.byte[1] & core.DTPH1_MASK)

    writecmd(core.DTPV0)
    writedata(y3.byte[0])
    writecmd(core.DTPV1)
    writedata(y3.byte[1] & core.DTPV1_MASK)

    ' set color
    fgcolor(c)

    ' draw
    writecmd(core.DCR)
    if ( f )
        writedata( core.DRAW_LINE_SQU_TRI | core.FILL_CIR_SQU_TRI | core.DRAW_TRIANGLE)
    else
        writedata( core.DRAW_LINE_SQU_TRI | core.DRAW_TRIANGLE)

    ' Wait for the command to finish
    waitnot(core.DCR, core.LINE_SQU_TRI_BUSY)


pub ts_debounce_enabled(e): c
' Enable touchscreen debounce circuit
'   e:
'       true (-1 or 1)
'       false (0)
'       other values:   return the current setting
    c := readreg(core.TPCR1)
    case abs(e)
        0, 1:
            e := (c & core.TPDCETPI_MASK) | ( (e & 1) << core.TPDCETPI)
            writereg(core.TPCR1, e)
        other:
            return ( (c >> core.TPDCETPI) & 1) == 1


pub ts_enabled(e): c
' Enable touchscreen
'   e:
'       true (-1 or 1)
'       false (0)
'       other values:   return the current setting
    c := readreg(core.TPCR0)
    case abs(e)
        0, 1:
            e := (c & core.TPEN_MASK) | ( (e & 1) << core.TPEN)
            writereg(core.TPCR0, e)
        other:
            return ( (c >> core.TPEN) & 1) == 1


pub ts_xy(): t | x, y   'xxx api tentative
' Get current touchscreen coordinates
'   Returns:
'       [b25..16]:  x coordinate (ADC word, u10)
'       [b9..0]:    y coordinate (ADC word, u10)
    x := (readreg(core.TPXH) << 2) | (readreg(core.TPXYL) & core.TPXLSB_BITS)
    y := (readreg(core.TPYH) << 2) | (readreg(core.TPXYL) >> core.TPYLSB) & core.TPYLSB_BITS
    return (x << 16) | y


pri busy(): s
' Check if the display is busy
    return pinr(_WAIT) == 0


pri readdata(): v
' Read data returned by command
    repeat
    while busy()
    pinl(_CS)
        spi.wr_byte(core.DATA_READ)
        v := spi.rd_byte()
    pinh(_CS)
    waitus(1)

    return v


pri readreg(reg_nr): v
' Read value from register
    writecmd(reg_nr)
    return readdata()


pri readstatus(): v
' Read the status register
    repeat
    while busy()

    pinl(_CS)
        spi.wr_byte(core.CMD_READ)
        v := spi.rd_byte()
    pinh(_CS)
    waitus(1)
    return v


pri waitnot(reg_nr, f): s
' Wait for a bitfield read from a register to be clear
    repeat
        s := readreg(reg_nr) & f
    while s


pri writecmd(c)
' Write command
    repeat
    while busy()

    pinl(_CS)
        spi.wr_byte(core.CMD_WRITE)
        spi.wr_byte(c)
    pinh(_CS)
    waitus(1)


pri writedata(v)
' Write command parameter or display data
    repeat
    while busy()

    pinl(_CS)
        spi.wr_byte(core.DATA_WRITE)
        spi.wr_byte(v)
    pinh(_CS)
    waitus(1)


pri writereg(reg_nr, val)
' Write value to register
    writecmd(reg_nr)
    writedata(val)


#include "terminal.common.spin2h"


