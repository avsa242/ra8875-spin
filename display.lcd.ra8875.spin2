    _hsync_finetune := 0
    _vsync_nondisp := 33
    _vsync_start := 8
    _vsync_pw := 10
    _voffset := 0

    _bl_pwm_freq := 1000

    set_timings()

    ' clear window
    writereg(core.MCLR, core.MCLR_START | core.MCLR_FULL)
