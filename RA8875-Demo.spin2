con

    _clkfreq    = 180_000_000
    _xtlfreq    = 20_000_000


obj

    ser:    "com.serial.terminal.ansi"
    disp:   "display.lcd.ra8875.spin2" | CS=28, SCK=25, MOSI=27, MISO=26, RST=29, WAIT=30, LITE=24, ...
                                        SPI_FREQ=5_000_000



pub main() | x1, y1, x2, y2, x3, y3, c

    setup()

    disp.brightness(50)

    repeat
        x1 := getrnd() +// 800
        y1 := getrnd() +// 480
        x2 := getrnd() +// 800
        y2 := getrnd() +// 480
        x3 := getrnd() +// 800
        y3 := getrnd() +// 480
        c := getrnd() +// $ffff
        disp.box(x1, y1, x2, y2, c, true)
'        disp.box_rounded(x1, y1, x2, y2, getrnd() +// 256, getrnd() +// 256, c, true)
'        disp.line(x1, y1, x2, y2, c)
'        disp.circle(x1, y1, getrnd() +// 256, c, true)
'        disp.triangle(x1, y1, x2, y2, x3, y3, c, true)
    repeat
        color_bars()


pub color_bars() | r, g, b, x

    r := 0
    repeat 800 with x
        disp.line(x, 0, x, 59, r << 11)
        r := x/25

    g := 0
    repeat 800 with x '797
        disp.line(x, 60, x, 119, g << 5)
        g := (x * 1_00) / 12_50 ' x / 12.5

    b := 0
    repeat 800 with x
        disp.line(x, 120, x, 179, b)
        b := x/25

    g := 0
    b := 0
    repeat 800 with x   ' 797
        disp.box(x, 180, x, 239, (g << 5) | b, true)
        g := (x * 1_00) / 12_50
        b := x/25


    r := 0
    b := 0
    repeat 800 with x
        disp.box(x, 240, x, 299, (r << 11) | b, true)
        r := x/25
        b := x/25

    r := 0
    g := 0
    repeat 800 with x
        disp.box(x, 300, x, 359, (r << 11) | (g << 5), true)
        r := x/25
        g := (x * 1_00) / 12_50


pub setup()

    ser.start()
    ser.clear()

    ser.strln(@"Serial terminal started")

    if ( disp.start() )
        ser.strln(@"RA8875 driver started")
        disp.preset_adafruit_800x480()
    else
        ser.strln(@"RA8875 driver failed to start - halting")
        repeat


dat
